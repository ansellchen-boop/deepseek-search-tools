{
  "name": "deepseek-search-tools",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Search / Fetch REST API (/v1/tools/search, /v1/tools/fetch) as DSH web providers — plus a configuration-driven multi-vendor backend list (Zhipu, OpenAI Responses web_search, Tavily, Jina Reader, SearXNG, Brave, plain HTTP).",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugins",
    "dsh",
    "dsh-plugin",
    "web-search",
    "web-fetch",
    "tools-api"
  ],
  "license": "MIT",
  "author": "deepseek-search-tools contributors",
  "homepage": "https://github.com/ansellchen-boop/deepseek-search-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansellchen-boop/deepseek-search-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ansellchen-boop/deepseek-search-tools/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/bridge.js",
    "lib/usage.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
